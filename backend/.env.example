# Copiar a backend/.env. Valores de desarrollo; no incluir secretos reales en Git.
# Coincide con PostgreSQL local descrito en backend/README.md (puerto 5434).
# Codificar caracteres reservados de usuario/contraseña al incluirlos en una URL.
DATABASE_URL="postgresql://urbanfix:urbanfix_pass@localhost:5434/urbanfix_db?schema=public"

# Puerto HTTP; si se omite, el servidor usa 3001.
PORT=3001

# Reemplazar por un secreto propio y aleatorio antes de iniciar la API.
# El README incluye un comando para generarlo. No usar este valor en producción.
JWT_SECRET="reemplazar-por-un-secreto-propio-aleatorio"

# La duración del JWT está fija en 7d en el código actual.
# JWT_EXPIRES_IN todavía no se consume (pendiente de la issue #11).
# Los orígenes CORS aún no tienen variable configurable (issue #11).

# Solo para el runner de migraciones que entrega la issue #9.
# Usar PostgreSQL de laboratorio exclusivo con privilegio CREATEDB.
# Pasarla explícitamente al ejecutar la suite; no usar conexión de producción.
# TEST_DATABASE_URL="postgresql://postgres:testpass@localhost:55432/postgres"
