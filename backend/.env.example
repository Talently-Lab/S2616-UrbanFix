# ==============================================================================
# UrbanFix - Configuración de Variables de Entorno (backend/.env)
# ==============================================================================
# Copiar este archivo a backend/.env para desarrollo local. No incluir secretos reales en Git.
#
# Comportamiento de comillas entre herramientas:
# - Docker Compose interpreta el archivo .env y despoja comillas alrededor de los valores.
# - En cambio, `docker run --env-file` conserva las comillas literales como parte del valor.
#   Si ejecutas contenedores directos con `--env-file`, define los valores sin comillas.

# Entorno de ejecución: development | test | production (predeterminado: development).
NODE_ENV=development

# Conexión a PostgreSQL:
# 1. Desarrollo local desde el host (conectando al puerto publicado 5434):
DATABASE_URL="postgresql://urbanfix:urbanfix_pass@localhost:5434/urbanfix_db?schema=public"

# 2. Conexión interna para contenedores Docker en Compose (host 'db' y puerto 5432):
# Requerida por el servicio 'api' en backend/compose.yaml.
# Si la contraseña contiene caracteres reservados (@, #, /, :, %, etc.), deben estar percent-encoded (RFC 3986):
#   Ejemplo: 'probe@secret#/' -> 'probe%40secret%23%2F'
#   DOCKER_DATABASE_URL="postgresql://urbanfix:probe%40secret%23%2F@db:5432/urbanfix_db?schema=public"
DOCKER_DATABASE_URL="postgresql://urbanfix:urbanfix_pass@db:5432/urbanfix_db?schema=public"

# Puerto en el que escucha la API HTTP (entero entre 1 y 65535, predeterminado: 3001).
PORT=3001

# Secreto para firma y verificación de JWT (mínimo 32 caracteres).
# OBLIGATORIO: La API no inicia sin este secreto configurado.
# El valor de ejemplo de abajo es rechazado intencionalmente al arrancar.
# Generar un secreto seguro con import explícito de crypto:
#   node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
JWT_SECRET="reemplazar-por-un-secreto-propio-aleatorio"

# Duración y expiración de tokens JWT (entero positivo con unidad explícita s, m, h, d).
# Ejemplos válidos: 30s, 15m, 1h, 7d. Predeterminado: 7d.
# No acepta cadenas numéricas sin unidad (para evitar ambigüedades en milisegundos).
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (lista de URLs HTTP/HTTPS separadas por comas, sin path ni query).
# En development y test, si se omite, usa por defecto: http://localhost:5173,http://127.0.0.1:5173
# En production, es OBLIGATORIA una allowlist explícita no vacía (no se permite '*' ni 'null').
# Solicitudes sin cabecera Origin (curl, monitoreo /health y /ready, servidor a servidor) siempre son permitidas.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==============================================================================
# Variables para Docker Compose (backend/compose.yaml)
# ==============================================================================
# Configuración del servicio de base de datos PostgreSQL local en Compose.
# Valores predeterminados exclusivamente para laboratorio y demostración local.
# NO usar credenciales de ejemplo en staging o producción.
POSTGRES_USER=urbanfix
POSTGRES_PASSWORD=urbanfix_pass
POSTGRES_DB=urbanfix_db
POSTGRES_PORT=5434

# ==============================================================================
# Entorno de Pruebas de Laboratorio
# ==============================================================================
# Obligatoria para `npm run test:migrations` y opcional para `npm test` (si no se usa Docker).
# Requiere una instancia exclusiva de PostgreSQL de pruebas con privilegio CREATEDB.
# Por seguridad arquitectónica (AGENTS.md), los runners nunca hacen fallback a DATABASE_URL.
# TEST_DATABASE_URL="postgresql://postgres:testpass@localhost:55432/postgres"
