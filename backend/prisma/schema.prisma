datasource db {
  provider = "postgresql"
}
/*Cada vez que cambies schema.prisma: npx prisma migrate dev --name descripcion_del_cambio, y luego npx prisma generate.*/
generator client {
  provider = "prisma-client-js"
}

enum Rol {
  CLIENTE
  TECNICO
  ADMIN
}

enum CategoriaServicio {
  PLOMERIA
  ELECTRICIDAD
  GAS
  CARPINTERIA
  PINTURA
  CERRAJERIA
  ALBANILERIA
  OTRO
}

enum EstadoSolicitud {
  PENDIENTE // Creada por el cliente, esperando asignación/respuesta
  ACEPTADA // Técnico aceptó el trabajo
  RECHAZADA // No se utiliza en el modelo de bolsa (el rechazo mantiene la solicitud en PENDIENTE)
  EN_PROCESO // Trabajo en ejecución
  FINALIZADA // Trabajo completado
  CANCELADA // Cancelada por el cliente o admin
}

model Usuario {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  nombre             String
  celular            String? // opcional
  rol                Rol      @default(CLIENTE)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  // Relaciones
  solicitudesComoCliente SolicitudServicio[]        @relation("SolicitudesComoCliente")
  solicitudesComoTecnico SolicitudServicio[]        @relation("SolicitudesComoTecnico")
  cambiosDeEstado        HistorialEstadoSolicitud[] @relation("CambiosDeEstado")
  rechazos               RechazoSolicitud[]         @relation("RechazosTecnico")
}

model HistorialEstadoSolicitud {
  id String @id @default(uuid())

  solicitudId String
  solicitud   SolicitudServicio @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  estadoAnterior EstadoSolicitud? // null en el primer registro
  estadoNuevo    EstadoSolicitud
  accion         String? // Ej: "RECHAZO", null para cambios de estado estándar

  cambiadoPorId String
  cambiadoPor   Usuario @relation("CambiosDeEstado", fields: [cambiadoPorId], references: [id])

  motivo      String? // útil para rechazos y cancelaciones
  fechaCambio DateTime @default(now())

  @@index([solicitudId])
}

model SolicitudServicio {
  id          String          @id @default(uuid())
  titulo      String
  descripcion String
  categoria   String // Ej: Plomería, Electricidad, Gas
  direccion   String
  estado      EstadoSolicitud @default(PENDIENTE)

  clienteId String
  cliente   Usuario @relation("SolicitudesComoCliente", fields: [clienteId], references: [id])

  tecnicoId String? //null hasta que un tecnico acepta
  tecnico   Usuario? @relation("SolicitudesComoTecnico", fields: [tecnicoId], references: [id])

  // Timestamps del ciclo de vida
  fechaCreacion      DateTime  @default(now())
  fechaAceptacion    DateTime? // técnico acepta
  fechaInicio        DateTime? // técnico arranca el trabajo
  fechaFinalizacion  DateTime? // trabajo completado
  fechaCancelacion   DateTime? // cancelada por cliente/admin
  fechaActualizacion DateTime  @updatedAt

  motivoCancelacion String?

  historialEstados HistorialEstadoSolicitud[]
  rechazos         RechazoSolicitud[]

  @@index([clienteId])
  @@index([tecnicoId])
  @@index([estado])
}

model RechazoSolicitud {
  id           String            @id @default(uuid())
  solicitudId  String
  solicitud    SolicitudServicio @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  tecnicoId    String
  tecnico      Usuario           @relation("RechazosTecnico", fields: [tecnicoId], references: [id], onDelete: Restrict)
  motivo       String
  fechaRechazo DateTime          @default(now())

  @@unique([solicitudId, tecnicoId])
  @@index([solicitudId])
  @@index([tecnicoId])
}

