# API

# URL base del backend para axios (frontend/src/services/api.js)
# Contrato: backend/docs/API_CONTRACT.md
VITE_API_URL=http://localhost:3001/api

# Auth simulada en el frontend (true/false). Mientras el backend no esté
# disponible se usa true (default): login/register resuelven localmente.
# Con false se usa la API real de Express + Prisma.
VITE_MOCK_AUTH=true
